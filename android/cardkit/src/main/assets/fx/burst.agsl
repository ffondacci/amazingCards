// Rotating ray burst behind a revealed rare card. Transparent outside the rays.
uniform shader content;
uniform float2 size;
uniform float2 tilt;
uniform float2 pointer;
uniform float time;
uniform float intensity;
uniform float3 tint;

half4 main(float2 position) {
    float4 color = float4(content.eval(position));
    float2 s = max(size, float2(1.0));
    float2 uv = position / s - 0.5;
    uv.x *= s.x / s.y;
    float r = length(uv);
    float ang = atan(uv.y, uv.x);
    float rays = pow(0.5 + 0.5 * sin(ang * 12.0 + time * 0.8), 3.0) * 0.7
        + pow(0.5 + 0.5 * sin(-ang * 7.0 + time * 0.5 + 1.0), 4.0) * 0.5;
    float falloff = smoothstep(0.9, 0.0, r);
    float glow = smoothstep(0.35, 0.0, r) * 0.8;
    float alpha = clamp((rays * falloff + glow) * intensity, 0.0, 1.0) * color.a;
    float3 col = mix(tint, float3(1.0), glow * 0.6);
    return half4(half3(col * alpha), half(alpha));
}
