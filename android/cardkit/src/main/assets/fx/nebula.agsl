// Coloured gas clouds; `palette` picks the scheme (violet, teal, ember, emerald). Generator.
uniform shader content;
uniform float2 size;
uniform float2 tilt;
uniform float2 pointer;
uniform float time;
uniform float intensity;
uniform float palette;

half4 main(float2 position) {
    float4 color = float4(content.eval(position));
    float2 s = max(size, float2(1.0));
    float2 uv = position / s;
    float2 q = float2(uv.x * (s.x / s.y), uv.y) * 2.2 + tilt * 0.08;
    float n1 = fbm(q + time * 0.02, 5);
    float n2 = fbm(q * 1.8 + float2(7.1, 2.3) - time * 0.015, 4);
    float3 a; float3 b; float3 c;
    int p = int(palette + 0.5);
    if (p == 1) { a = float3(0.02, 0.12, 0.16); b = float3(0.05, 0.45, 0.50); c = float3(0.95, 0.70, 0.25); }
    else if (p == 2) { a = float3(0.12, 0.02, 0.04); b = float3(0.55, 0.10, 0.08); c = float3(1.00, 0.55, 0.15); }
    else if (p == 3) { a = float3(0.02, 0.10, 0.08); b = float3(0.05, 0.40, 0.30); c = float3(0.35, 0.95, 0.85); }
    else { a = float3(0.06, 0.02, 0.18); b = float3(0.10, 0.20, 0.55); c = float3(0.85, 0.30, 0.65); }
    float3 gas = mix(a, b, n1);
    gas = mix(gas, c, smoothstep(0.50, 0.85, n2));
    gas *= 0.35 + 0.9 * smoothstep(0.3, 0.9, n1);
    gas += stars(q, 28.0, tilt * 0.01, time, 3.0) * float3(0.9, 0.95, 1.0) * 0.8;
    return premulRgb(gas * clamp(intensity, 0.0, 1.5), color.a);
}
