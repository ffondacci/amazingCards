// Local paper tension over a wrapper: a dent and radial wrinkles under the
// finger, ripples ahead of the cut. Generator: emits light and shade with
// alpha, to composite normally over the pack.
uniform shader content;
uniform float2 size;
uniform float2 point;
uniform float front;
uniform float direction;
uniform float strength;
uniform float time;

float heightAt(float2 q) {
    float2 d = q - point;
    float r = length(d);
    float v = -strength * 9.0 * exp(-r * r / (2.0 * 20.0 * 20.0));
    float ang = atan(d.y, d.x);
    v -= strength * 2.2 * exp(-r / 55.0) * pow(0.5 + 0.5 * sin(ang * 9.0 + 1.3), 5.0) * ss(0.0, 12.0, r);
    float ahead = (q.x - front) * direction;
    float ripple = sin(ahead * 0.45 - time * 2.0) * exp(-max(ahead, 0.0) / 45.0) * step(0.0, ahead);
    float band = exp(-pow((q.y - point.y) / 26.0, 2.0));
    v -= strength * 2.4 * ripple * band;
    return v;
}

half4 main(float2 position) {
    if (strength < 0.005) { return half4(0.0); }
    const float e = 1.0;
    float h0 = heightAt(position + float2(e, 0.0));
    float h1 = heightAt(position + float2(-e, 0.0));
    float h2 = heightAt(position + float2(0.0, e));
    float h3 = heightAt(position + float2(0.0, -e));
    float3 n = normalize(float3(-(h0 - h1) / (2.0 * e) * 1.4, -(h2 - h3) / (2.0 * e) * 1.4, 1.0));
    float3 L = normalize(float3(-0.35, -0.55, 0.9));
    float flatLit = L.z;
    float diffuse = max(dot(n, L), 0.0);
    float3 R = reflect(-L, n);
    float spec = pow(max(R.z, 0.0), 32.0);
    float delta = (diffuse - flatLit) * 0.9 + spec * 0.5;
    float a = clamp(abs(delta), 0.0, 0.8);
    float3 col = delta > 0.0 ? float3(1.0, 0.98, 0.9) : float3(0.0);
    return half4(half3(col * a), half(a));
}
